	name: "incp4b/5x5r_w"
    lr_mult: 1
    decay_mult: 1
  }
  param {
	name: "incp4b/5x5r_b"
    lr_mult: 2
    decay_mult: 0
  }
  convolution_param {
    num_output: 24
    kernel_size: 1
    weight_filler {
      type: "xavier"
    }
    bias_filler {
      type: "constant"
      value: 0.2
    }
  }
}
layer {
  name: "inception_4b/relu_5x5_reduce"
